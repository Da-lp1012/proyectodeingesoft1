# Solo para correr el backend FUERA de docker compose (npm run dev / npm start),
# por ejemplo contra la base compartida del equipo (g2-team-4-db) del paso B de la guía.
# Con "docker compose up" en la raíz NO hace falta: compose inyecta estas variables.
# Copia como .env; el archivo .env NO se sube a Git.
DB_HOST=IP_DEL_SERVIDOR_DE_BASE_DE_DATOS
DB_PORT=PUERTO_DEL_SERVIDOR_DE_BASE_DE_DATOS
DB_NAME=g2-team-4-db
DB_USER=g2_team_4_user
DB_PASSWORD=CONTRASEÑA_DEL_USUARIO_DEL_EQUIPO
PORT=3000
