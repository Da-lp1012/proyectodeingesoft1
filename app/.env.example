# Copia como .env (cp .env.example .env). El .env NO se sube a Git.
# Úsalo en la VM y para probar contra la base real (por ejemplo con un túnel de PuTTY).

# --- Base de datos del equipo ---
DB_HOST=IP_DE_LA_BASE_DE_DATOS
DB_PORT=5432
DB_NAME=g2-team-4-db
DB_USER=g2_team_4_user
# Si la contraseña lleva "$", escríbela como "$$".
DB_PASSWORD=CONTRASEÑA_DEL_USUARIO_DEL_EQUIPO

# --- Puertos publicados (en la VM compartida usen números propios, ej. 5174 y 3004) ---
API_PORT=3000
WEB_PORT=5173

# Poner en true si el hot-reload del frontend no detecta cambios (Docker Desktop en Windows/macOS).
WATCH_POLLING=false
